generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  projectMembers   ProjectMember[]
  invitesCreated   ProjectInvite[] @relation("ProjectInviteCreatedBy")
  activityLogs     ActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Project.slug is the URL segment for `/projects/[slug]` (unique per workspace).
model Project {
  id                 String            @id @default(uuid())
  slug               String            @unique
  name               String
  description        String?
  /// Source git remote (e.g. https://github.com/org/repo) for clone-on-provision; not the live preview URL.
  cloneRepositoryUrl String?
  repositoryLocation String?
  environmentStatus  EnvironmentStatus @default(INACTIVE)
  lastActivityAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  members            ProjectMember[]
  invites            ProjectInvite[]
  activityLogs       ActivityLog[]

  @@index([userId])
}

/// User-visible audit trail (container start/stop, etc.) for dashboard and `/logs`.
model ActivityLog {
  id        String            @id @default(uuid())
  userId    String
  projectId String
  action    String
  status    ActivityLogStatus
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

enum ActivityLogStatus {
  DONE
  RUNNING
  STOPPED
}

/// Collaborators invited via share link (see `ProjectInvite`). Owner remains `Project.userId`.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

/// Opaque token in `/projects/invite/[token]` — only project owner can create.
model ProjectInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  projectId   String
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum EnvironmentStatus {
  INACTIVE
  PROVISIONING
  RUNNING
  STOPPED
  ERROR
}
