generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Environment {
  id          String            @id @default(uuid())
  projectId   String
  containerId String?
  image       String            @default("node:20-alpine")
  /// Canonical https git remote (no credentials), for auditing / recreate flows.
  gitRemoteUrl String?
  status      EnvironmentStatus @default(INACTIVE)
  port        Int?
  /// Subdomain slug for public access via Traefik (e.g. "my-app-a3f9" → my-app-a3f9.synaro.io).
  /// Only set when SYNARO_DOMAIN env var is configured on the environment service.
  subdomain    String?           @unique
  /// Optional custom domain connected by the user (e.g. "myapp.com").
  customDomain String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}

enum EnvironmentStatus {
  INACTIVE
  PROVISIONING
  RUNNING
  STOPPED
  ERROR
}

/// A production deployment: an always-up, isolated snapshot of a project's workspace, built and
/// run in its own container (separate from the ephemeral editing/preview environment). One per project.
model Deployment {
  id           String           @id @default(uuid())
  projectId    String           @unique
  containerId  String?
  image        String           @default("node:20-alpine")
  status       DeploymentStatus @default(INACTIVE)
  /// Stable public subdomain via Traefik (e.g. "my-app" → my-app.synaro.tech). Set when SYNARO_DOMAIN is configured.
  subdomain    String?          @unique
  /// Optional custom domain connected by the user (e.g. "myapp.com").
  customDomain String?
  /// Git commit the deployment was built from, if known.
  commitSha    String?
  /// Resolved production start command (for diagnostics/UI).
  runCommand   String?
  deployedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId])
}

enum DeploymentStatus {
  INACTIVE
  BUILDING
  RUNNING
  STOPPED
  ERROR
}