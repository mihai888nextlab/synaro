generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Execution {
  id          String          @id @default(uuid())
  projectId   String
  containerId String?         // retained, always null under Kubernetes
  status      ExecutionStatus @default(STOPPED)
  subdomain   String?         // {projectId}.{SYNARO_DOMAIN} once the Ingress is created
  startedAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

enum ExecutionStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}
